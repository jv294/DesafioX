# Configuração do Banco de Dados - MongoDB Atlas (Nuvem)
# Substitua a URL abaixo pela sua string de conexão obtida no painel do MongoDB Atlas.
# Exemplo: mongodb+srv://meu_usuario:minha_senha@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/app?retryWrites=true&w=majority

# Nome do banco de dados dentro do seu cluster Atlas
MONGODB_DBNAME=app

# Porta onde o servidor Express rodará localmente
PORT=3001
